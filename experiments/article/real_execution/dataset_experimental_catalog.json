{
  "session_length_schedule": {
    "allowed_lengths": [4, 6, 8, 10, 12],
    "global_average_length": 8,
    "rationale": "Variable session lengths are used to avoid a fixed Q1-Q8 pattern while preserving the V2 total of 37440 query-level decisions over 4680 sessions/validations."
  },
  "allow_block_profiles": [
    {
      "id": "mostly_allow",
      "description": "Most queries are expected to contribute to the active objective.",
      "expected_allow_ratio_range": [0.65, 0.9]
    },
    {
      "id": "mostly_block",
      "description": "Most queries are expected to be blocked because they are out-of-objective, contradictory, or non-calculable.",
      "expected_allow_ratio_range": [0.1, 0.35]
    },
    {
      "id": "balanced_mixed",
      "description": "ALLOW and BLOCK decisions are approximately balanced.",
      "expected_allow_ratio_range": [0.4, 0.6]
    },
    {
      "id": "progressive_coverage",
      "description": "A session starts with partial contributions and progressively covers the objective.",
      "expected_allow_ratio_range": [0.45, 0.75]
    },
    {
      "id": "contradictory_or_invalid",
      "description": "The session includes contradictory slicers, wrong granularity, private attributes, or measures outside the active objective.",
      "expected_allow_ratio_range": [0.0, 0.4]
    }
  ],
  "datasets": {
    "foodmart": {
      "business_domain": "Retail decision analysis",
      "objectives": [
        {
          "id": "fm_retail_sales_profit_state_month",
